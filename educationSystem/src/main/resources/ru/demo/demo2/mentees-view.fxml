<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.demo.demo2.controller.MenteesController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20"/>
    </padding>

    <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #333; -fx-padding: 0 0 10 0;" text="Управление подопечными"/>

    <HBox spacing="10">
        <TextField fx:id="searchField" promptText="Поиск..." prefWidth="250" style="-fx-padding: 8px; -fx-font-size: 13px; -fx-border-color: #2196F3; -fx-border-width: 2px; -fx-border-radius: 4px; -fx-background-radius: 4px;"/>
    </HBox>

    <HBox spacing="10">
        <Button onAction="#onAddClick" text="Добавить" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10px 20px; -fx-cursor: hand; -fx-background-radius: 5px; -fx-font-size: 13px;"/>
        <Button onAction="#onEditClick" text="Редактировать" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10px 20px; -fx-cursor: hand; -fx-background-radius: 5px; -fx-font-size: 13px;"/>
        <Button onAction="#onDeleteClick" text="Удалить" style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10px 20px; -fx-cursor: hand; -fx-background-radius: 5px; -fx-font-size: 13px;"/>
        <Button onAction="#onRefreshClick" text="Обновить" style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10px 20px; -fx-cursor: hand; -fx-background-radius: 5px; -fx-font-size: 13px;"/>
    </HBox>

    <TableView fx:id="menteesTable" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-width: 1px; -fx-border-radius: 5px; -fx-background-radius: 5px;">
        <columns>
            <TableColumn fx:id="idColumn" prefWidth="50" visible="false" text="ID"/>
            <TableColumn fx:id="fioColumn" prefWidth="200" text="ФИО"/>
            <TableColumn fx:id="emailColumn" prefWidth="150" text="Email"/>
            <TableColumn fx:id="goalsColumn" prefWidth="250" text="Цели"/>
            <TableColumn fx:id="levelColumn" prefWidth="100" text="Уровень"/>
        </columns>
    </TableView>
    
    <Label fx:id="statusLabel" style="-fx-font-size: 13px; -fx-text-fill: #555; -fx-font-weight: bold; -fx-padding: 5 0 0 0;"/>
</VBox>
