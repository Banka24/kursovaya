<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.demo.demo2.controller.PairsController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20"/>
    </padding>

    <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Управление парами наставник-подопечный"/>

    <HBox spacing="10">
        <Button onAction="#onAddClick" text="Создать пару"/>
        <Button onAction="#onEditClick" text="Редактировать"/>
        <Button onAction="#onDeleteClick" style="-fx-background-color: #f44336; -fx-text-fill: white;" text="Удалить"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button onAction="#onRefreshClick" text="Обновить"/>
    </HBox>

    <Label fx:id="resultLabel" style="-fx-font-size: 12px;"/>

    <TableView fx:id="pairsTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn" visible="false" prefWidth="50" text="ID"/>
            <TableColumn fx:id="mentorColumn" prefWidth="200" text="Наставник"/>
            <TableColumn fx:id="menteeColumn" prefWidth="200" text="Подопечный"/>
            <TableColumn fx:id="startDateColumn" prefWidth="120" text="Дата начала"/>
            <TableColumn fx:id="statusColumn" prefWidth="120" text="Статус"/>
        </columns>
    </TableView>
</VBox>