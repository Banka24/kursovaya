<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.educationsystem.educationsystem.controller.MenteesController">
    <top>
        <VBox spacing="10.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <children>
                    <Button text="Добавить" onAction="#addMentee" />
                    <Button text="Изменить" onAction="#editMentee" />
                    <Button text="Удалить" onAction="#deleteMentee" />
                    <Separator orientation="VERTICAL" />
                    <Button text="Обновить" onAction="#refreshMentees" />
                </children>
            </HBox>
            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <children>
                    <Label text="Поиск:" />
                    <TextField fx:id="searchField" prefWidth="200.0" />
                    <Button text="Найти" onAction="#searchMentees" />
                </children>
            </HBox>
        </VBox>
    </top>
    <center>
        <TableView fx:id="menteesTable" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="idColumn" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="lastNameColumn" prefWidth="120.0" text="Фамилия" />
                <TableColumn fx:id="firstNameColumn" prefWidth="120.0" text="Имя" />
                <TableColumn fx:id="middleNameColumn" prefWidth="120.0" text="Отчество" />
                <TableColumn fx:id="emailColumn" prefWidth="180.0" text="Email" />
                <TableColumn fx:id="goalsColumn" prefWidth="150.0" text="Цели" />
                <TableColumn fx:id="currentLevelColumn" prefWidth="100.0" text="Текущий уровень" />
                <TableColumn fx:id="hasMentorColumn" prefWidth="100.0" text="Есть наставник" />
            </columns>
        </TableView>
    </center>
</BorderPane>
