<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.educationsystem.educationsystem.controller.MeetingsController">
    <children>
        <Label text="Журнал встреч" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

        <HBox spacing="10.0">
            <children>
                <ComboBox fx:id="pairComboBox" promptText="Выберите пару" prefWidth="200.0" />
                <DatePicker fx:id="meetingDatePicker" promptText="Дата встречи" />
                <TextField fx:id="topicField" promptText="Тема встречи" prefWidth="200.0" />
                <Button text="Добавить встречу" onAction="#addMeeting" />
            </children>
        </HBox>

        <TableView fx:id="meetingsTable" prefHeight="300.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="pairColumn" text="Пара" prefWidth="200.0" />
                <TableColumn fx:id="dateColumn" text="Дата" prefWidth="150.0" />
                <TableColumn fx:id="topicColumn" text="Тема" prefWidth="250.0" />
                <TableColumn fx:id="tasksColumn" text="Выполненные задачи" prefWidth="200.0" />
                <TableColumn fx:id="ratingColumn" text="Оценка" prefWidth="100.0" />
                <TableColumn fx:id="actionsColumn" text="Действия" prefWidth="100.0" />
            </columns>
        </TableView>

        <HBox spacing="10.0" alignment="CENTER_RIGHT">
            <children>
                <Button text="Закрыть" onAction="#closeWindow" />
            </children>
        </HBox>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
