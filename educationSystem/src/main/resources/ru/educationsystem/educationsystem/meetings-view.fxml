<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.educationsystem.educationsystem.controller.MeetingsController"
      style="-fx-background-color: #f5f5f5;">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
    <Label text="Журнал встреч"
           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #333333;"/>

    <HBox spacing="15.0" alignment="CENTER_LEFT"
          style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8;">
        <VBox spacing="5">
            <Label text="Пара:" style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
            <ComboBox fx:id="pairComboBox" promptText="Выберите пару" prefWidth="200.0"
                      style="-fx-background-radius: 5;"/>
        </VBox>
        <VBox spacing="5">
            <Label text="Дата:" style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
            <DatePicker fx:id="meetingDatePicker" promptText="Дата встречи" prefWidth="150.0"
                        style="-fx-background-radius: 5;"/>
        </VBox>
        <VBox spacing="5">
            <Label text="Тема:" style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
            <TextField fx:id="topicField" promptText="Тема встречи" prefWidth="200.0"
                       style="-fx-background-radius: 5;"/>
        </VBox>
        <Button text="Добавить встречу" onAction="#addMeeting"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;"
                prefHeight="35"/>
    </HBox>

    <TableView fx:id="meetingsTable" prefHeight="350.0" VBox.vgrow="ALWAYS"
               style="-fx-background-radius: 8; -fx-border-radius: 8;">
        <columns>
            <TableColumn fx:id="pairColumn" text="Пара" prefWidth="200.0"/>
            <TableColumn fx:id="dateColumn" text="Дата" prefWidth="150.0"/>
            <TableColumn fx:id="topicColumn" text="Тема" prefWidth="200.0"/>
            <TableColumn fx:id="tasksColumn" text="Выполненные задачи" prefWidth="200.0"/>
            <TableColumn fx:id="ratingColumn" text="Оценка"/>
            <TableColumn fx:id="actionsColumn" text="Действия" prefWidth="150.0"/>
        </columns>
    </TableView>

</VBox>