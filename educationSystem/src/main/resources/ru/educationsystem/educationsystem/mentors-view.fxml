<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ru.educationsystem.educationsystem.controller.MentorsController"
            style="-fx-background-color: #f5f5f5;">
    <top>
        <VBox spacing="15.0">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <Label text="Наставники" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #333333;"/>
            <HBox spacing="10.0" alignment="CENTER_LEFT"
                  style="-fx-background-color: white; -fx-padding: 10; -fx-background-radius: 8;">
                <Button text="Добавить" onAction="#addMentor"
                        style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;"/>
                <Button text="Изменить" onAction="#editMentor"
                        style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;"/>
                <Button text="Удалить" onAction="#deleteMentor"
                        style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;"/>
                <Separator orientation="VERTICAL"/>
                <Button text="Обновить" onAction="#refreshMentors"
                        style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;"/>
            </HBox>
            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Label text="Поиск:" style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
                <TextField fx:id="searchField" prefWidth="250.0" promptText="Введите текст для поиска..."
                           style="-fx-background-radius: 5;"/>
                <Button text="Найти" onAction="#searchMentors"
                        style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <VBox>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" />
            </padding>
            <TableView fx:id="mentorsTable" BorderPane.alignment="CENTER" VBox.vgrow="ALWAYS"
                       style="-fx-background-radius: 8;">
                <columns>
                    <TableColumn fx:id="idColumn" prefWidth="50.0" text="ID" visible="false" />
                    <TableColumn fx:id="lastNameColumn" prefWidth="120.0" text="Фамилия" />
                    <TableColumn fx:id="firstNameColumn" prefWidth="120.0" text="Имя" />
                    <TableColumn fx:id="middleNameColumn" prefWidth="120.0" text="Отчество" />
                    <TableColumn fx:id="emailColumn" prefWidth="180.0" text="Email" />
                    <TableColumn fx:id="specializationColumn" prefWidth="150.0" text="Специализация" />
                    <TableColumn fx:id="availableColumn" prefWidth="90.0" text="Доступен" />
                    <TableColumn fx:id="directionsColumn" prefWidth="150.0" text="Направления" />
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>