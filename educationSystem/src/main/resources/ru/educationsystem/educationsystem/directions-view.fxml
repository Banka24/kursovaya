<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.educationsystem.educationsystem.controller.DirectionsController">
    <top>
        <VBox spacing="10.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <children>
                    <Button text="Добавить" onAction="#addDirection" />
                    <Button text="Изменить" onAction="#editDirection" />
                    <Button text="Удалить" onAction="#deleteDirection" />
                    <Separator orientation="VERTICAL" />
                    <Button text="Обновить" onAction="#refreshDirections" />
                </children>
            </HBox>
            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <children>
                    <Label text="Поиск:" />
                    <TextField fx:id="searchField" prefWidth="200.0" />
                    <Button text="Найти" onAction="#searchDirections" />
                </children>
            </HBox>
        </VBox>
    </top>
    <center>
        <TableView fx:id="directionsTable" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="idColumn" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="nameColumn" prefWidth="300.0" text="Название" />
                <TableColumn fx:id="mentorsCountColumn" prefWidth="150.0" text="Кол-во наставников" />
            </columns>
        </TableView>
    </center>
</BorderPane>
