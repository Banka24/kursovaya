<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.educationsystem.educationsystem.controller.ReportsController">
    <children>
        <Label text="Генерация отчетов" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

        <GridPane hgap="10.0" vgap="10.0">
            <children>
                <Label text="Тип отчета:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                <ComboBox fx:id="reportTypeComboBox" prefWidth="200.0" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                <Label text="Период с:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                <DatePicker fx:id="startDatePicker" prefWidth="200.0" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                <Label text="Период по:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                <DatePicker fx:id="endDatePicker" prefWidth="200.0" GridPane.rowIndex="2" GridPane.columnIndex="1" />

                <Label text="Направление:" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                <ComboBox fx:id="directionComboBox" prefWidth="200.0" GridPane.rowIndex="3" GridPane.columnIndex="1" />
            </children>
        </GridPane>

        <TextArea fx:id="reportPreviewArea" prefHeight="200.0" editable="false" />

        <HBox spacing="10.0" alignment="CENTER_RIGHT">
            <children>
                <Button text="Сформировать отчет" onAction="#generateReport" />
                <Button text="Экспорт в PDF" onAction="#exportToPdf" />
                <Button text="Закрыть" onAction="#closeWindow" />
            </children>
        </HBox>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
