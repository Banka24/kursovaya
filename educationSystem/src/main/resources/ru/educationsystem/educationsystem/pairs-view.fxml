<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.educationsystem.educationsystem.controller.PairsController"
      style="-fx-background-color: #f5f5f5;">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
    <Label text="Управление парами наставник-подопечный"
           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #333333;"/>

    <HBox spacing="15.0" alignment="CENTER_LEFT"
          style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8;">
        <VBox spacing="5">
            <Label text="Наставник:" style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
            <ComboBox fx:id="mentorComboBox" promptText="Выберите наставника" prefWidth="220.0"
                      style="-fx-background-radius: 5;"/>
        </VBox>
        <VBox spacing="5">
            <Label text="Подопечный:" style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
            <ComboBox fx:id="menteeComboBox" promptText="Выберите подопечного" prefWidth="220.0"
                      style="-fx-background-radius: 5;"/>
        </VBox>
        <Button text="Создать пару" onAction="#addPair"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;"
                prefHeight="35"/>
    </HBox>

    <TableView fx:id="pairsTable" prefHeight="350.0" VBox.vgrow="ALWAYS"
               style="-fx-background-radius: 8; -fx-border-radius: 8;">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="50.0" visible="false"/>
            <TableColumn fx:id="mentorColumn" text="Наставник" prefWidth="200.0"/>
            <TableColumn fx:id="menteeColumn" text="Подопечный" prefWidth="200.0"/>
            <TableColumn fx:id="startDateColumn" text="Дата начала" prefWidth="120.0"/>
            <TableColumn fx:id="statusColumn" text="Статус" prefWidth="100.0"/>
        </columns>
    </TableView>

    <HBox spacing="10.0" alignment="CENTER_RIGHT">
        <Button text="Редактировать" onAction="#editPair"
                style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;"/>
        <Button text="Удалить" onAction="#deletePair"
                style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;"/>
        <Button text="Обновить" onAction="#refreshPairs"
                style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;"/>
    </HBox>
</VBox>