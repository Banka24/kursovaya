<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.educationsystem.educationsystem.controller.PairsController">
    <children>
        <Label text="Управление парами наставник-подопечный" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

        <HBox spacing="10.0">
            <children>
                <ComboBox fx:id="mentorComboBox" promptText="Выберите наставника" prefWidth="200.0" />
                <ComboBox fx:id="menteeComboBox" promptText="Выберите подопечного" prefWidth="200.0" />
                <Button text="Создать пару" onAction="#addPair" />
            </children>
        </HBox>

        <TableView fx:id="pairsTable" prefHeight="300.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="50.0" />
                <TableColumn fx:id="mentorColumn" text="Наставник" prefWidth="200.0" />
                <TableColumn fx:id="menteeColumn" text="Подопечный" prefWidth="200.0" />
                <TableColumn fx:id="startDateColumn" text="Дата начала" prefWidth="120.0" />
                <TableColumn fx:id="statusColumn" text="Статус" prefWidth="100.0" />
            </columns>
        </TableView>

        <HBox spacing="10.0" alignment="CENTER_RIGHT">
            <children>
                <Button text="Закрыть" onAction="#closeWindow" />
            </children>
        </HBox>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
