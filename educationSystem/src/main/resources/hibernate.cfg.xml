<?xml version = "1.0" encoding = "utf-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <!-- Set URL -->
        <property name = "hibernate.connection.url">jdbc:postgresql://localhost:5432/education</property>
        <!-- Set User Name -->
        <property name = "hibernate.connection.username">postgres</property>
        <!-- Set Password -->
        <property name = "hibernate.connection.password">postgres</property>
        <!-- Set Driver Name -->
        <property name = "hibernate.connection.driver_class">org.postgresql.Driver</property>
        <property name = "hibernate.show_sql">true</property>
        <!-- Optional: Auto-generate schema -->
        <!-- <property name = "hibernate.hbm2ddl.auto">create</property> -->

        <!-- Entity classes -->
        <mapping class="ru.educationsystem.educationsystem.model.User"/>
        <mapping class="ru.educationsystem.educationsystem.model.Mentor"/>
        <mapping class="ru.educationsystem.educationsystem.model.Level"/>
        <mapping class="ru.educationsystem.educationsystem.model.Mentee"/>
        <mapping class="ru.educationsystem.educationsystem.model.Direction"/>
        <mapping class="ru.educationsystem.educationsystem.model.MenteeGoal"/>
        <mapping class="ru.educationsystem.educationsystem.model.Pair"/>
        <mapping class="ru.educationsystem.educationsystem.model.DevelopmentPlan"/>
        <mapping class="ru.educationsystem.educationsystem.model.Meeting"/>

    </session-factory>
</hibernate-configuration>